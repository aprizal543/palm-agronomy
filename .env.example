APP_ENV=development
APP_NAME=PalmAgronomy API
API_V1_PREFIX=/api/v1
# Runtime: use the Supabase session pooler URL and append ssl=require.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres?ssl=require
# Migration: use the direct Supabase connection when IPv6 is available.
MIGRATION_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres?ssl=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
SQL_ECHO=false

# Sprint 2 — never commit real secrets. Create the bot through @BotFather.
TELEGRAM_ENABLED=false
TELEGRAM_MODE=webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_REQUEST_TIMEOUT_S=10

# Provider-neutral default. A hosted LLM can be connected in a later increment.
AGENT_PROVIDER=deterministic
AGENT_MODEL=
